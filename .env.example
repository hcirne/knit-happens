# Copy this file to .env and fill in the blanks:
#
#   cp .env.example .env
#
# Never commit .env — it is gitignored. Keep this example file up to date whenever
# a new variable is introduced, so the rest of the team knows what to set.

# --- Database -----------------------------------------------------------------
# Read by docker-compose.yml when it creates the Postgres container. Changing these
# after the container exists has no effect until you run `docker compose down -v`,
# which deletes the data and lets it be created again.
POSTGRES_USER=knit
POSTGRES_PASSWORD=knit_local_dev
POSTGRES_DB=knit_happens
POSTGRES_PORT=5432

# Read by Prisma. The host is localhost (not "db") because the app runs on your
# machine, not inside Docker, and reaches Postgres through the published port above.
# Keep the credentials here in sync with the four variables above.
DATABASE_URL="postgresql://knit:knit_local_dev@localhost:5432/knit_happens?schema=public"

# --- Session (UC-01, UC-02) ---------------------------------------------------
# Signs the kh_session cookie in src/lib/auth.js. Required in production.
# Generate your own, do not share it:
#
#   openssl rand -base64 32
#
SESSION_SECRET=

# --- Uploads (UC-04) ----------------------------------------------------------
# Where uploaded project photos are written. The database stores only the path.
# This directory is gitignored. Next semester, when the app itself runs in Docker,
# it becomes a mounted volume.
UPLOAD_DIR=./public/uploads
