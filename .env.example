# Copy this file to .env and fill in the blanks:
#
#   cp .env.example .env
#
# Never commit .env — it is gitignored. Keep this example file up to date whenever
# a new variable is introduced, so the rest of the team knows what to set.

# --- Database -----------------------------------------------------------------
# Read by docker-compose.yml when it creates the Postgres container, AND by the
# Spring Boot backend (application.properties imports this file with
# spring.config.import) to connect to that database. Changing these after the
# container exists has no effect until you run `docker compose down -v`, which
# deletes the data and lets it be created again.
POSTGRES_USER=knit
POSTGRES_PASSWORD=knit_local_dev
POSTGRES_DB=knit_happens
POSTGRES_PORT=5432

# --- Uploads (UC-04) ----------------------------------------------------------
# Where uploaded project photos are written. The database stores only the file name.
# The path is relative to backend/ (where the backend is started). The directory is
# gitignored. Next semester, when the app itself runs in Docker, it becomes a
# mounted volume.
UPLOAD_DIR=./uploads
