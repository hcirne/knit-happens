// Knit Happens database schema.
//
// Never change the database by hand. Every change goes through a migration:
//
//   npx prisma migrate dev --name what_you_changed
//
// Prisma 7 notes, because these differ from most tutorials online:
//  - The connection URL is in prisma7.config.mjs, not in the datasource block.
//  - We use the "prisma-client-js" generator. The newer "prisma-client" generator
//    emits TypeScript, and this project is JavaScript only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// The categories shown as filter chips in Explore (UC-03) and in the Category
/// select of the Share form (UC-04).
enum Category {
  SWEATERS
  HATS
  SOCKS
  SHAWLS
  BLANKETS
}

/// A person with an account. Created by UC-01, signed in by UC-02.
model User {
  id String @id @default(cuid())

  /// The public handle shown on projects and comments, e.g. "maren.knits".
  username String @unique
  email    String @unique

  /// bcrypt hash. Never return this from a server action or an API route.
  passwordHash String

  createdAt DateTime @default(now())

  projects Project[]
  comments Comment[]
}

/// A shared knitting project. Created by UC-04, listed by UC-03.
model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  category    Category
  createdAt   DateTime @default(now())

  authorId String
  // Restrict: Postgres refuses to delete a user who still has projects, so an
  // accidental delete cannot silently destroy content. Revisit when account
  // deletion is actually built (SRS DR-005).
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  photos   Photo[]
  comments Comment[]

  /// The feed is ordered newest first (FR-015).
  @@index([createdAt])
}

/// One uploaded photo belonging to a project.
///
/// Only the path on disk is stored, never the image bytes. Files are written to
/// the directory named by UPLOAD_DIR.
model Photo {
  id   String @id @default(cuid())
  path String

  /// Display order within the project, starting at 0. Deliberately not unique:
  /// a unique constraint would make any future reordering fail halfway through
  /// a swap.
  position Int

  projectId String
  // Cascade: deleting a project should take its photos with it. They belong to
  // that project alone and are meaningless without it.
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// A comment written under a project. Created by UC-05.
model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  /// Comments are read per project in chronological order (FR-022).
  @@index([projectId, createdAt])
}
